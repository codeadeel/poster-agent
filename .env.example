# Copy to .env. Everything here is optional.

# Login token for JupyterLab. Empty means no login at all. The port is open to anyone who can reach
# this machine, so set a token if it isn't just you. Then open http://<host>:8888/?token=<token>
JUPYTER_TOKEN=

# The address you browse from, if it isn't localhost (for example the server's IP or hostname).
# Needed so the poster images in notebook 01 load.
PUBLIC_HOST=localhost

# Secret shared by the MCP server and the fake poster service
POSTER_API_KEY=demo-key-change-me

# Lets the agent notebook use a real model (nemotron-3-nano:30b on Ollama Cloud)
OLLAMA_API_KEY=

# 0.3 makes jobs take about 1.5 to 6 s, 1 is the real 5 to 20 s
MOCK_TIME_SCALE=0.3
